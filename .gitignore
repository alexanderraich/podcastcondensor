# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
*.whl
venv/

# Output artifacts — SRTs, per-episode global_state, and universe/super-cut
# caches ARE version-controlled (LLM-generated, expensive to regenerate).
# Everything else (audio, diag logs, temp) stays ignored.
output/*
!output/*.gitkeep
!output/universe_state_*.json
!output/super_cut_*.json

# Per-episode: whisper SRT + global_state.json (LLM extraction) tracked
# NOTE: must un-ignore the ep dirs BEFORE re-ignoring their contents, else
# git never descends into them and the negations below never fire.
!output/ep-*/
output/ep-*/*
!output/ep-*/source_subtitles.srt
!output/ep-*/global_state.json

# Temp
*.tmp
*.temp

# Pytest cache
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local ffmpeg/yt-dlp binaries
.local/

# Claude Code local settings
.claude/settings.local.json

# Debug directory
src/output/
